# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NÃO deve ser enviado ao Git.

# Chave secreta da aplicação (use um valor longo e aleatório)
SECRET_KEY=troque-por-uma-chave-secreta-longa

# 1 = modo debug ligado (apenas desenvolvimento) | 0 = desligado
FLASK_DEBUG=1

# Banco de dados (opcional). Se omitido, usa instance/helpdesk.db
# DATABASE_URL=sqlite:///helpdesk.db

# Diferença em horas para UTC ao exibir datas e horas (padrão -3 = Brasília).
# As datas são guardadas em UTC no banco.
# FUSO_HORARIO_HORAS=-3

# Alerta visual nos dashboards: destaca chamados abertos há mais de N horas
# (e atendimentos sem atualização há mais de N horas). Padrão: 24.
# Não é um prazo (SLA), apenas um aviso.
# ALERTA_ESPERA_HORAS=24
